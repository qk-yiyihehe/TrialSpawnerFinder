{
  "schemaVersion": 1,
  "id": "trial-spawner-finder",
  "version": "${version}",
  "name": "Minecraft Finders",
  "description": "Runs trial spawner and geode finders with Minecraft 1.21.1 world generation.",
  "environment": "server",
  "entrypoints": {
    "server": [
      "cn.minecraftfinder.runtime.MinecraftFindersMod"
    ]
  },
  "mixins": [
    "trial-spawner-finder.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "1.21.1",
    "java": ">=21"
  }
}
